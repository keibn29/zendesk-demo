# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
# All secrets are read from the environment only and are never logged.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=zendesk-support-bridge
LOG_LEVEL=INFO
# "development" is required if you ever set DEV_DISABLE_SIGNATURE_VERIFICATION.
ENVIRONMENT=production
DATABASE_URL=sqlite+aiosqlite:///./data/bridge.sqlite3

# --- Slack ---
# Signing secret from your Slack app (Basic Information -> Signing Secret).
SLACK_SIGNING_SECRET=slack-signing-secret-placeholder
# Bot token with the `reactions:write` scope (e.g. xoxb-...).
SLACK_BOT_TOKEN=xoxb-placeholder
# Optional comma-separated channel allowlist. Leave empty to accept every
# channel the app is a member of.
SLACK_CHANNEL_ALLOWLIST=

# --- Zendesk ---
# Your Zendesk subdomain only, e.g. "acme" for acme.zendesk.com.
ZENDESK_SUBDOMAIN=acme
# Signing secret of the Zendesk webhook.
ZENDESK_WEBHOOK_SECRET=zendesk-webhook-secret-placeholder

# Preferred auth: OAuth access token.
ZENDESK_OAUTH_TOKEN=

# Legacy fallback auth: agent email + API token (Settings -> API token).
# Only required when ZENDESK_OAUTH_TOKEN is empty.
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# --- Security (defense in depth) ---
# Optional extra shared token checked in addition to (never instead of) the
# webhook signature. Leave empty to disable this layer.
WEBHOOK_SHARED_TOKEN=
WEBHOOK_SHARED_TOKEN_HEADER=X-Webhook-Token
# DEV ONLY escape hatch for local testing. The app refuses to start with this
# enabled unless ENVIRONMENT=development. Never enable in production.
DEV_DISABLE_SIGNATURE_VERIFICATION=false

# --- Behavior ---
# Replay window for both Slack and Zendesk signatures, in seconds.
SIGNATURE_TOLERANCE_SECONDS=300
HTTP_TIMEOUT_SECONDS=10
# TOTAL wall-clock budget for ONE upstream service call, enforced with
# asyncio.timeout. httpx's per-phase timeout alone can let a single request run
# several times longer, which could outlive our own claim lease.
PROCESSING_DEADLINE_SECONDS=60
# A claim left in 'processing' longer than this is treated as abandoned
# (worker crash) and becomes retryable. MUST be >= PROCESSING_DEADLINE_SECONDS
# + CLAIM_TIMEOUT_MARGIN_SECONDS, otherwise the app refuses to start: a lease
# shorter than an upstream call would let a second worker take over mid-request
# and create a duplicate ticket.
PROCESSING_CLAIM_TIMEOUT_SECONDS=900
CLAIM_TIMEOUT_MARGIN_SECONDS=60

# --- Reaction defaults ---
# Statuses are the Zendesk ticket status (or custom trigger `action`).
REACTION_NEW=eyes
REACTION_OPEN=eyes
REACTION_PENDING=hourglass_flowing_sand
REACTION_HOLD=hourglass_flowing_sand
REACTION_SOLVED=white_check_mark
REACTION_CLOSED=white_check_mark